---
import BaseLayout from "../layouts/BaseLayout.astro";
import Seccion from "../components/Seccion.astro";
import UbicacionHorario from "../components/UbicacionHorario.astro";
import FormularioContacto from "../components/FormularioContacto.astro";
---

<BaseLayout
  title="Contacto — Terra Studio"
  description="Escríbenos por WhatsApp o por formulario. Dirección, horario y mapa de Terra Studio en Temuco."
>
  <Seccion fondo="base">
    <h1 class="contacto__titulo">Contacto</h1>
    <p class="prosa contacto__intro">
      La forma más rápida de agendar es WhatsApp. Si prefieres escribirnos por
      formulario, también llega.
    </p>
  </Seccion>

  <UbicacionHorario />

  <Seccion fondo="oscuro">
    <h2 class="contacto__titulo">Escríbenos</h2>
    <FormularioContacto />
  </Seccion>
</BaseLayout>

<style>
  .contacto__titulo {
    text-align: center;
    margin-block-end: var(--space-3);
  }

  .contacto__intro {
    text-align: center;
    max-width: 50ch;
    margin-inline: auto;
  }
</style>
