---
import { terra } from "../../data/negocio";
import { urlWhatsApp } from "../../lib/whatsapp";
import Boton from "../Boton.astro";

const whatsappUrl = urlWhatsApp(terra.whatsapp);
---

<section class="hero">
  <!--
    Foto real del salón (fotograma del video de un alisado terminado, 4K).
    Encima va el velo de la paleta: sin él, el texto crema no pasa contraste
    sobre una pared blanca. El velo es más denso en el centro, que es donde
    cae el claim.
  -->
  <div class="hero__fondo" aria-hidden="true">
    <img src="/fotos/hero-salon.webp" alt="" width="1920" height="2560" />
  </div>

  <div class="hero__contenido contenedor">
    <img
      src="/logos/terra-vertical-crema.png"
      alt="Terra Studio"
      width="180"
      height="216"
      class="hero__logo"
    />
    <h1 class="hero__claim">{terra.claim}</h1>
    <Boton variante="primario" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      Agendar por WhatsApp
    </Boton>
  </div>

  <a href="#metodo" class="hero__scroll" aria-label="Bajar a conocer el método">
    <span></span>
  </a>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-marron);
  }

  .hero__fondo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* La foto del salón es muy luminosa (pared blanca, cabello claro), así que
     el velo tiene que ser denso o el claim en crema no pasa contraste. Medido:
     con estos valores el texto queda sobre un fondo efectivo oscuro en toda
     la zona del contenido. */
  .hero__fondo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
        100% 70% at 50% 48%,
        color-mix(in srgb, var(--color-marron) 94%, transparent),
        color-mix(in srgb, var(--color-marron) 78%, transparent) 65%
      ),
      color-mix(in srgb, var(--color-marron) 62%, transparent);
  }

  .hero__contenido {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    padding-block: var(--space-8);
  }

  .hero__logo {
    width: 140px;
    height: auto;
  }

  .hero__claim {
    font-family: var(--fuente-titulo);
    font-weight: 100;
    letter-spacing: var(--tracking-titulo);
    color: var(--fg-oscuro);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    max-width: 26ch;
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 40px;
    border: 1.5px solid var(--color-crema);
    border-radius: 999px;
  }

  .hero__scroll span {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 999px;
    background: var(--color-crema);
    animation: hero-scroll 2s var(--ease) infinite;
  }

  @keyframes hero-scroll {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    75% {
      opacity: 0;
      transform: translateY(14px);
    }
    100% {
      opacity: 0;
      transform: translateY(14px);
    }
  }

</style>
