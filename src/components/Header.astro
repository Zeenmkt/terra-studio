---
import { servicios } from "../data/servicios";
import { terra } from "../data/negocio";
import { urlWhatsApp } from "../lib/whatsapp";
import Boton from "./Boton.astro";

const enlaces = [
  { href: "/nosotras", texto: "Nosotras" },
  { href: "/contacto", texto: "Contacto" },
];

const rutaActual = Astro.url.pathname.replace(/\/$/, "") || "/";
const esActual = (href: string) => rutaActual === href;
const whatsappUrl = urlWhatsApp(terra.whatsapp);
---

<header class="encabezado">
  <div class="encabezado__barra contenedor">
    <a href="/" class="encabezado__logo" aria-current={esActual("/") ? "page" : undefined}>
      <img
        src="/logos/terra-horizontal-terracota.png"
        alt="Terra Studio"
        width="183"
        height="44"
      />
    </a>

    <nav class="encabezado__nav" aria-label="Principal">
      <details class="desplegable">
        <summary>Servicios</summary>
        <ul>
          {
            servicios.map((servicio) => (
              <li>
                <a
                  href={`/${servicio.slug}`}
                  aria-current={esActual(`/${servicio.slug}`) ? "page" : undefined}
                >
                  {servicio.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      {
        enlaces.map((enlace) => (
          <a href={enlace.href} aria-current={esActual(enlace.href) ? "page" : undefined}>
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <div class="encabezado__whatsapp">
      <Boton variante="primario" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        Agendar por WhatsApp
      </Boton>
    </div>

    <button
      type="button"
      class="hamburguesa"
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="menu-movil" class="menu-movil">
    <div class="menu-movil__interior">
      <ul>
        <li><a href="/">Inicio</a></li>
        {
          servicios.map((servicio) => (
            <li>
              <a href={`/${servicio.slug}`}>{servicio.nombre}</a>
            </li>
          ))
        }
        {
          enlaces.map((enlace) => (
            <li>
              <a href={enlace.href}>{enlace.texto}</a>
            </li>
          ))
        }
      </ul>
      <Boton variante="primario" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        Agendar por WhatsApp
      </Boton>
    </div>
  </div>
</header>

<style>
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg-base);
    border-bottom: 1px solid color-mix(in srgb, var(--color-marron) 15%, transparent);
  }

  .encabezado__barra {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .encabezado__logo {
    margin-right: auto;
    line-height: 0;
  }

  .encabezado__logo img {
    height: 44px;
    width: auto;
  }

  .encabezado__nav {
    display: none;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .encabezado__nav > a[aria-current="page"] {
    color: var(--fg-titulo);
  }

  .desplegable summary {
    cursor: pointer;
    list-style: none;
  }

  .desplegable summary::-webkit-details-marker {
    display: none;
  }

  .desplegable summary::after {
    content: "";
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
    transition: transform var(--dur-hover) var(--ease);
  }

  .desplegable[open] summary::after {
    transform: translateY(0.05em) rotate(225deg);
  }

  .desplegable {
    position: relative;
  }

  .desplegable ul {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    margin: 0;
    padding: var(--space-1);
    list-style: none;
    background: var(--bg-base);
    border: 1px solid color-mix(in srgb, var(--color-marron) 15%, transparent);
    border-radius: 12px;
    min-width: 220px;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-marron) 12%, transparent);
  }

  .desplegable li a {
    display: block;
    padding: var(--space-1) var(--space-2);
    border-radius: 8px;
    white-space: nowrap;
  }

  .desplegable li a:hover,
  .desplegable li a[aria-current="page"] {
    background: var(--bg-oscuro);
    color: var(--fg-oscuro);
  }

  .encabezado__whatsapp {
    display: none;
  }

  .hamburguesa {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .hamburguesa span {
    display: block;
    height: 2px;
    background: var(--color-marron);
    border-radius: 1px;
    transition: transform var(--dur-hover) var(--ease), opacity var(--dur-hover) var(--ease);
  }

  .hamburguesa[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburguesa[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .hamburguesa[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .menu-movil {
    display: grid;
    grid-template-rows: 0fr;
    background: var(--bg-oscuro);
    color: var(--fg-oscuro);
    transition: grid-template-rows var(--dur-base) var(--ease);
  }

  .menu-movil.abierto {
    grid-template-rows: 1fr;
  }

  .menu-movil__interior {
    overflow: hidden;
    min-height: 0;
  }

  .menu-movil ul {
    list-style: none;
    margin: 0;
    padding: var(--space-3) var(--space-3) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .menu-movil :global(.boton) {
    margin: var(--space-3);
  }

  @media (min-width: 768px) {
    .encabezado__nav,
    .encabezado__whatsapp {
      display: inline-flex;
    }

    .hamburguesa,
    .menu-movil {
      display: none;
    }
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>(".hamburguesa");
  const menu = document.querySelector<HTMLDivElement>("#menu-movil");

  if (boton && menu) {
    const cerrar = () => {
      boton.setAttribute("aria-expanded", "false");
      menu.classList.remove("abierto");
    };

    boton.addEventListener("click", () => {
      const abierto = boton.getAttribute("aria-expanded") === "true";
      boton.setAttribute("aria-expanded", String(!abierto));
      menu.classList.toggle("abierto", !abierto);
    });

    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape") cerrar();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) cerrar();
    });
  }
</script>
