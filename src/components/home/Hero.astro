---
import { terra } from "../../data/negocio";
import { urlWhatsApp } from "../../lib/whatsapp";
import Boton from "../Boton.astro";

const whatsappUrl = urlWhatsApp(terra.whatsapp);
---

<section class="hero">
  <!--
    El salón de Terra: un paneo por la hilera de espejos (IMG_1310, grabado a
    60 cuadros por segundo). Se estabilizó, va en cámara lenta al 50 % —sin
    cuadros inventados, porque el original tiene el doble— y el loop va
    siempre hacia adelante: el final se funde con el inicio en 1,5 s en vez
    de devolverse en reversa, que era lo que hacía ver raro el anterior.

    Hay dos versiones del mismo corte. En el teléfono, vertical (576×1024,
    1,0 MB); desde 768 px, horizontal (1152×648, 0,9 MB), recortada del mismo
    cuadro. Antes era un solo video vertical de 540 px y en escritorio se
    estiraba al doble y se veía borroso. Cada visitante descarga uno solo.

    El fotograma va primero y el video encima, con preload="none". Así la
    primera pintura es una imagen liviana y el LCP no depende del video: si
    el video nunca llega a cargar —conexión lenta, ahorro de datos, o el
    visitante pidió menos movimiento— la portada se ve exactamente igual,
    solo quieta. Encima va el velo de la paleta, concentrado detrás del texto.
  -->
  <div class="hero__fondo" aria-hidden="true">
    <picture>
      <source
        media="(min-width: 768px)"
        srcset="/fotos/hero-poster-escritorio.webp"
        width="1280"
        height="720"
      />
      <img
        src="/fotos/hero-poster-movil.webp"
        alt=""
        width="720"
        height="1280"
        fetchpriority="high"
        class="hero__cuadro"
      />
    </picture>
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      data-hero-video
    ></video>
  </div>

  <div class="hero__contenido contenedor">
    <img
      src="/logos/terra-vertical-crema.png"
      alt="Terra Studio"
      width="180"
      height="216"
      class="hero__logo"
    />
    <h1 class="hero__claim">{terra.claim}</h1>
    <Boton variante="primario" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      Agendar por WhatsApp
    </Boton>
  </div>

  <a href="#metodo" class="hero__scroll" aria-label="Bajar a conocer el método">
    <span></span>
  </a>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-marron);
  }

  /* El <picture> no debe ocupar caja propia: la imagen se mide contra el fondo. */
  .hero__fondo picture {
    display: contents;
  }

  .hero__cuadro,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* El video se superpone al fotograma y aparece cuando ya puede reproducir,
     así nunca se ve un salto ni un hueco negro. */
  .hero__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }

  .hero__video.esta-listo {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  /* El velo se concentra solo donde va el texto: denso hasta el 62 % de la
     elipse y desde ahí cae casi a cero, para que el salón se vea en los
     bordes. La forma cambia con la pantalla porque el bloque de texto también:
     en el teléfono ocupa todo el ancho, así que la elipse es ancha y baja; en
     tablet y escritorio el texto es una columna angosta y la elipse se cierra.
     Medido sobre el fotograma real: el claim queda sobre 3,7:1 o más en 375,
     768 y 1280 px (texto grande, el mínimo AA es 3:1). Si se cambia el video,
     hay que volver a medir. */
  .hero__fondo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
        90% 40% at 50% 48%,
        color-mix(in srgb, var(--color-marron) 86%, transparent),
        color-mix(in srgb, var(--color-marron) 86%, transparent) 62%,
        color-mix(in srgb, var(--color-marron) 10%, transparent)
      ),
      color-mix(in srgb, var(--color-marron) 20%, transparent);
  }

  @media (min-width: 768px) {
    .hero__fondo::after {
      background: radial-gradient(
          52% 46% at 50% 48%,
          color-mix(in srgb, var(--color-marron) 86%, transparent),
          color-mix(in srgb, var(--color-marron) 86%, transparent) 62%,
          color-mix(in srgb, var(--color-marron) 10%, transparent)
        ),
        color-mix(in srgb, var(--color-marron) 20%, transparent);
    }
  }

  .hero__contenido {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    padding-block: var(--space-8);
  }

  .hero__logo {
    width: 140px;
    height: auto;
  }

  .hero__claim {
    font-family: var(--fuente-titulo);
    font-weight: 100;
    letter-spacing: var(--tracking-titulo);
    color: var(--fg-oscuro);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    max-width: 26ch;
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    width: 24px;
    height: 40px;
    border: 1.5px solid var(--color-crema);
    border-radius: 999px;
  }

  .hero__scroll span {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 999px;
    background: var(--color-crema);
    animation: hero-scroll 2s var(--ease) infinite;
  }

  @keyframes hero-scroll {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    75% {
      opacity: 0;
      transform: translateY(14px);
    }
    100% {
      opacity: 0;
      transform: translateY(14px);
    }
  }

</style>

<script>
  // El video del hero es un agregado, no un requisito. Se carga recién cuando
  // la página ya terminó de cargar, y solo si conviene: nunca con ahorro de
  // datos activado, nunca en 2G, y nunca si el visitante pidió menos
  // movimiento. En cualquiera de esos casos queda el fotograma, que ya está
  // pintado, y no se descarga ni un byte de video.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");

  if (video) {
    const conexion = (navigator as any).connection;
    const ahorroDeDatos = conexion?.saveData === true;
    const redLenta = /(^|-)2g$/.test(conexion?.effectiveType ?? "");
    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!ahorroDeDatos && !redLenta && !menosMovimiento) {
      // Mismo corte que el fotograma: horizontal desde 768 px, vertical abajo.
      const escritorio = window.matchMedia("(min-width: 768px)");
      const fuente = () =>
        escritorio.matches ? "/video/hero-escritorio.mp4" : "/video/hero-movil.mp4";

      const cargar = () => {
        video.addEventListener(
          "canplay",
          () => {
            video.classList.add("esta-listo");
            video.play().catch(() => {
              // Si el navegador bloquea la reproducción automática, el
              // fotograma sigue ahí: no hay nada que reparar.
              video.classList.remove("esta-listo");
            });
          },
          { once: true }
        );
        video.src = fuente();
        video.load();
      };

      // Si cambia el ancho (una tablet que se gira), se cambia al otro corte.
      // Solo si el video ya se estaba usando: no se descarga nada antes de tiempo.
      escritorio.addEventListener("change", () => {
        if (!video.getAttribute("src")) return;
        video.classList.remove("esta-listo");
        cargar();
      });

      if (document.readyState === "complete") {
        cargar();
      } else {
        window.addEventListener("load", cargar, { once: true });
      }

      // El navegador pausa el video mientras la pestaña está oculta. Si alguien
      // abre la web en segundo plano y vuelve después, sin esto se encontraría
      // el hero congelado en un fotograma.
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible" && video.src && video.paused) {
          video.play().catch(() => {});
        }
      });
    }
  }
</script>
