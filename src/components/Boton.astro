---
interface Props {
  variante?: "primario" | "secundario" | "fantasma";
  href?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit";
  class?: string;
}

const {
  variante = "primario",
  href,
  target,
  rel,
  type = "button",
  class: className,
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  class:list={["boton", `boton--${variante}`, className]}
  href={href}
  target={target}
  rel={rel}
  type={href ? undefined : type}
>
  <slot />
</Tag>

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border: none;
    border-radius: 999px;
    font-family: var(--fuente-cuerpo);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: transform var(--dur-hover) var(--ease), background var(--dur-hover) var(--ease);
  }

  .boton--primario {
    background: var(--bg-impacto);
    color: var(--fg-impacto);
  }

  .boton--secundario {
    background: transparent;
    color: var(--fg-titulo);
    border: 1px solid var(--color-terracota);
  }

  .boton--primario:hover,
  .boton--secundario:hover {
    transform: scale(1.02);
  }

  .boton--fantasma {
    background: none;
    padding: 0;
    border-radius: 0;
    color: inherit;
    font-weight: 400;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--dur-hover) var(--ease);
  }

  .boton--fantasma:hover {
    background-size: 100% 1px;
  }
</style>
