---
import { servicios } from "../../data/servicios";
import { formatearCLP } from "../../lib/formato";
import Seccion from "../Seccion.astro";
import Arco from "../Arco.astro";

function precioDesde(servicio) {
  return servicio.precios
    ? servicio.precios.melena
    : Math.min(...servicio.opciones.map((o) => o.precio));
}

// Solo los tratamientos de los que Konny mandó material propio llevan foto.
// Reconstrucción SOS y Masaje capilar siguen con el arco de color hasta que
// lleguen fotos de ESOS tratamientos — no se rellenan con fotos de otro.
//
// Las cuatro fotos del primer lote eran la misma clienta en la misma sesión, y
// la de Alisado orgánico mostraba ondas con capas en vez de un alisado. Con el
// segundo lote se reemplazaron tres por clientas distintas entre sí. Botox
// capilar conserva la suya: es el único sin material propio, y esa foto sí
// muestra lo que deja el tratamiento (cabello suave, con brillo y movimiento).
const fotos = {
  "alisado-organico": "Cabello largo, liso y con brillo después de un alisado orgánico",
  "botox-capilar": "Cabello suave y con brillo después de un botox capilar",
  "corte-bordado": "Cabello largo con las puntas parejas después de un corte bordado",
  cortes: "Corte en capas con ondas y movimiento",
};
---

<Seccion id="servicios" fondo="base">
  <h2 class="servicios__titulo">Servicios</h2>
  <ul class="servicios__grid">
    {
      servicios.map((servicio) => (
        <li data-reveal-item>
          <a href={`/${servicio.slug}`} class="tarjeta-servicio">
            <Arco
              ratio="3 / 4"
              fondo={fotos[servicio.slug] ? undefined : "superficie"}
              class="tarjeta-servicio__arco"
            >
              {fotos[servicio.slug] && (
                <img
                  src={`/fotos/servicios/${servicio.slug}.webp`}
                  alt={fotos[servicio.slug]}
                  width="900"
                  height="1200"
                  loading="lazy"
                />
              )}
            </Arco>
            <h3>{servicio.nombre}</h3>
            <p class="texto-sm">{servicio.bajada}</p>
            <p class="tarjeta-servicio__precio">Desde {formatearCLP(precioDesde(servicio))}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Seccion>

<style>
  .servicios__titulo {
    text-align: center;
    margin-block-end: var(--space-6);
  }

  .servicios__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .tarjeta-servicio {
    display: block;
    transition: transform var(--dur-hover) var(--ease);
  }

  .tarjeta-servicio:hover {
    transform: scale(1.02);
  }

  .tarjeta-servicio h3 {
    margin-block-start: var(--space-2);
  }

  .tarjeta-servicio .texto-sm {
    margin-block-start: var(--space-1);
    color: var(--color-marron);
  }

  .tarjeta-servicio__precio {
    margin-block-start: var(--space-2);
    font-weight: 600;
    color: var(--fg-titulo);
  }

  /* :global — .tarjeta-servicio__arco vive en el <div> que renderiza Arco.astro.
     Ganamos especificidad a su regla .arco--superficie sumando el :hover del
     padre (mismo patrón que en Header, ver la nota ahí). Las tarjetas con foto
     no tienen fondo propio, así que ahí el hover se resuelve con un zoom. */
  :global(.tarjeta-servicio:hover .tarjeta-servicio__arco) {
    background-color: var(--bg-impacto);
  }

  :global(.tarjeta-servicio__arco img) {
    transition: transform var(--dur-hover) var(--ease);
  }

  :global(.tarjeta-servicio:hover .tarjeta-servicio__arco img) {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.tarjeta-servicio__arco img) {
      transition: none;
    }

    :global(.tarjeta-servicio:hover .tarjeta-servicio__arco img) {
      transform: none;
    }
  }

  @media (min-width: 640px) {
    .servicios__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .servicios__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
