---
interface Props {
  fondo?: "base" | "impacto" | "oscuro" | "superficie";
  espacio?: "normal" | "amplio";
  as?: "section" | "footer" | "div";
  id?: string;
  class?: string;
}

const {
  fondo = "base",
  espacio = "normal",
  as: Tag = "section",
  id,
  class: className,
} = Astro.props;
---

<Tag
  id={id}
  class:list={["seccion", `seccion--${fondo}`, `seccion--${espacio}`, className]}
  data-reveal
>
  <div class="contenedor">
    <slot />
  </div>
</Tag>

<style>
  .seccion {
    padding-block: var(--section-padding);
  }

  .seccion--amplio {
    padding-block: var(--space-9);
  }

  .seccion--base {
    background: var(--bg-base);
    color: var(--fg-base);
  }

  .seccion--impacto {
    background: var(--bg-impacto);
    color: var(--fg-impacto);
  }

  .seccion--oscuro {
    background: var(--bg-oscuro);
    color: var(--fg-oscuro);
  }

  .seccion--superficie {
    background: var(--bg-superficie);
    color: var(--fg-superficie);
  }
</style>

<script>
  const prefiereMenosMovimiento = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const objetivos = [...document.querySelectorAll("[data-reveal]")];

  if (prefiereMenosMovimiento) {
    for (const el of objetivos) el.classList.add("is-visible");
  } else {
    const revelar = (el: Element) => {
      el.classList.add("is-visible");
      observador.unobserve(el);
    };

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          // `isIntersecting` cubre el scroll normal. La segunda condición cubre
          // el scroll rápido: si la sección pasó de largo sin llegar a
          // intersectar, queda arriba del viewport y hay que revelarla igual.
          if (entrada.isIntersecting || entrada.boundingClientRect.top < 0) {
            revelar(entrada.target);
          }
        }
      },
      { threshold: 0.15 }
    );

    for (const el of objetivos) observador.observe(el);

    // Red de seguridad para los saltos que el observador no alcanza a ver: un
    // ancla, el botón de volver, o un deslizamiento muy rápido en el teléfono.
    // Sin esto una sección puede quedarse en opacidad 0 para siempre, y el
    // visitante ve un hueco en blanco donde debería haber contenido.
    const rescatar = () => {
      for (const el of objetivos) {
        if (
          !el.classList.contains("is-visible") &&
          el.getBoundingClientRect().bottom < 0
        ) {
          revelar(el);
        }
      }
    };

    window.addEventListener("scroll", rescatar, { passive: true });
    window.addEventListener("pageshow", rescatar);
  }
</script>
