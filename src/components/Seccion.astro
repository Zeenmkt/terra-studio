---
interface Props {
  fondo?: "base" | "impacto" | "oscuro" | "superficie";
  espacio?: "normal" | "amplio";
  as?: "section" | "footer" | "div";
  id?: string;
  class?: string;
}

const {
  fondo = "base",
  espacio = "normal",
  as: Tag = "section",
  id,
  class: className,
} = Astro.props;
---

<Tag
  id={id}
  class:list={["seccion", `seccion--${fondo}`, `seccion--${espacio}`, className]}
  data-reveal
>
  <div class="contenedor">
    <slot />
  </div>
</Tag>

<style>
  .seccion {
    padding-block: var(--section-padding);
  }

  .seccion--amplio {
    padding-block: var(--space-9);
  }

  .seccion--base {
    background: var(--bg-base);
    color: var(--fg-base);
  }

  .seccion--impacto {
    background: var(--bg-impacto);
    color: var(--fg-impacto);
  }

  .seccion--oscuro {
    background: var(--bg-oscuro);
    color: var(--fg-oscuro);
  }

  .seccion--superficie {
    background: var(--bg-superficie);
    color: var(--fg-superficie);
  }
</style>

<script>
  const prefiereMenosMovimiento = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const objetivos = document.querySelectorAll("[data-reveal]");

  if (prefiereMenosMovimiento) {
    for (const el of objetivos) el.classList.add("is-visible");
  } else {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (entrada.isIntersecting) {
            entrada.target.classList.add("is-visible");
            observador.unobserve(entrada.target);
          }
        }
      },
      { threshold: 0.15 }
    );

    for (const el of objetivos) observador.observe(el);
  }
</script>
