---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BotonFlotanteWhatsApp from "../components/BotonFlotanteWhatsApp.astro";

interface Props {
  title: string;
  description?: string;
  imagen?: string;
}

const { title, description, imagen = "/logos/terra-horizontal-terracota.png" } = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const urlImagen = new URL(imagen, Astro.site);
---

<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={urlCanonica} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="business.business" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagen} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="schema" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a href="#main" class="saltar-al-contenido">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BotonFlotanteWhatsApp />
  </body>
</html>
