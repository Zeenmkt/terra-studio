---
import { terra } from "../data/negocio";
import { urlWhatsApp } from "../lib/whatsapp";
import Seccion from "./Seccion.astro";
import Boton from "./Boton.astro";

const dias: [string, string | null][] = [
  ["Lunes", terra.horario.lunes],
  ["Martes", terra.horario.martes],
  ["Miércoles", terra.horario.miercoles],
  ["Jueves", terra.horario.jueves],
  ["Viernes", terra.horario.viernes],
  ["Sábado", terra.horario.sabado],
  ["Domingo", terra.horario.domingo],
];

const direccionCompleta = `${terra.direccion.calle}, ${terra.direccion.ciudad}, ${terra.direccion.region}, ${terra.direccion.pais}`;
const mapaUrl = `https://www.google.com/maps?q=${encodeURIComponent(direccionCompleta)}&output=embed`;
const comoLlegarUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(direccionCompleta)}`;
const whatsappUrl = urlWhatsApp(terra.whatsapp);
---

<Seccion id="ubicacion" fondo="base">
  <h2 class="ubicacion__titulo">Ubícanos</h2>
  <div class="ubicacion__grid">
    <div class="ubicacion__info" data-reveal-item>
      <p>
        {terra.direccion.calle}, {terra.direccion.detalle}
        <br />
        {terra.direccion.referencia}
      </p>
      <ul class="ubicacion__horario">
        {
          dias.map(([dia, horas]) => (
            <li>
              <span>{dia}</span>
              <span>{horas ?? "Cerrado"}</span>
            </li>
          ))
        }
      </ul>
      <div class="ubicacion__botones">
        <Boton variante="primario" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Agendar por WhatsApp
        </Boton>
        <Boton variante="secundario" href={comoLlegarUrl} target="_blank" rel="noopener noreferrer">
          Cómo llegar
        </Boton>
      </div>
    </div>
    <div class="ubicacion__mapa" data-reveal-item>
      <iframe
        src={mapaUrl}
        title={`Mapa de ubicación de ${terra.nombre}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </div>
  </div>
</Seccion>

<style>
  .ubicacion__titulo {
    text-align: center;
    margin-block-end: var(--space-6);
  }

  .ubicacion__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .ubicacion__info p {
    margin-block-end: var(--space-3);
  }

  .ubicacion__horario {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 260px;
  }

  .ubicacion__horario li {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
  }

  .ubicacion__botones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ubicacion__mapa {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-arco);
    overflow: hidden;
  }

  .ubicacion__mapa iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (min-width: 768px) {
    .ubicacion__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }
</style>
